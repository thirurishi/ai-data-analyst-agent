# Example environment configuration for local development
# Copy this file to .env and replace example values as needed.
# Do not commit real secrets or API keys.

APP_NAME="AI Data Analyst Agent API"
APP_ENV="development"
DEBUG="true"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"

EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_API_BASE_URL="https://api.openai.com/v1/embeddings"
EMBEDDING_DIMENSIONS="1536"
# "memory" keeps the RAG index in this API process only: it is lost on restart and not shared
# between workers. Use "postgres" (requires pgvector and the POSTGRES_* settings) for a durable index.
EMBEDDING_VECTOR_STORE="memory"

POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""
